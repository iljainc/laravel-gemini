{
    "name": "idpromogroup/laravel-gemini",
    "description": "Laravel package for Gemini generateContent with the same request API as laravel-openai-responses",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "IDPromoGroup",
            "email": "idpromogroup@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Idpromogroup\\LaravelGemini\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Idpromogroup\\LaravelGemini\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Idpromogroup\\LaravelGemini\\LaravelGeminiServiceProvider"
            ],
            "aliases": {
                "Lg": "Idpromogroup\\LaravelGemini\\Facades\\Lg"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
